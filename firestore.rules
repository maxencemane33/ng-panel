rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul le compte partagé (celui dont le mot de passe est ton code) a accès.
    // Vérifier l'e-mail empêche quelqu'un de créer son propre compte Firebase
    // pour contourner le code.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'pays@ngpanel.app';
    }
  }
}
